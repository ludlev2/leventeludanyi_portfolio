---
import { siteConfig } from '@/lib/site-config';

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 bg-bg-primary/90 backdrop-blur-sm border-b border-border">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="font-display text-xl text-text-primary hover:text-accent transition-colors"
    >
      LL
    </a>

    <!-- Navigation -->
    <ul class="flex items-center gap-8">
      {siteConfig.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'font-mono text-xs tracking-wide transition-colors relative',
              pathname === item.href || pathname.startsWith(item.href + '/')
                ? 'text-text-primary'
                : 'text-text-muted hover:text-text-secondary'
            ]}
          >
            {item.name}
            {(pathname === item.href || pathname.startsWith(item.href + '/')) && (
              <span class="absolute -bottom-1.5 left-0 right-0 h-[1px] bg-accent-muted" />
            )}
          </a>
        </li>
      ))}

      <!-- Theme Toggle -->
      <li>
        <button
          id="theme-toggle"
          class="text-text-muted hover:text-text-primary transition-colors p-1"
          aria-label="Toggle theme"
        >
          <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('light', isDark);
    document.documentElement.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  });
</script>

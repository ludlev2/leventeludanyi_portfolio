---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal/Terminal';
import { formatDate } from '@/lib/utils';

interface Props {
  title: string;
  date: Date;
  author: string;
  tags?: string[];
  summary?: string;
  readingTime?: string;
}

const { title, date, author, tags = [], summary, readingTime } = Astro.props;

// Get first letter for drop cap effect
const firstLetter = title.charAt(0).toUpperCase();
---

<BaseLayout title={`${title} | Levente Ludanyi`} description={summary}>
  <Header />

  <main class="min-h-screen pt-24 pb-20">
    <article class="max-w-2xl mx-auto px-6">
      <!-- Editorial post header -->
      <header class="mb-16 relative">
        <!-- Decorative accent line -->
        <div class="absolute -left-4 sm:-left-8 top-0 w-[2px] h-20 bg-gradient-to-b from-accent via-accent-muted to-transparent"></div>

        <!-- Meta row -->
        <div class="flex items-center gap-4 mb-8">
          <time
            datetime={date.toISOString()}
            class="font-mono text-xs text-text-muted tracking-wide"
          >
            {formatDate(date)}
          </time>
          {readingTime && (
            <>
              <span class="text-text-muted/40">•</span>
              <span class="font-mono text-xs text-text-muted">{readingTime}</span>
            </>
          )}
        </div>

        <!-- Title with elegant sizing -->
        <h1 class="heading-display text-4xl sm:text-5xl lg:text-6xl mb-8 leading-[1.1]">
          {title}
        </h1>

        <!-- Summary as elegant lede -->
        {summary && (
          <p class="text-xl sm:text-2xl text-text-secondary leading-relaxed font-display font-light">
            {summary}
          </p>
        )}

        <!-- Tags with refined styling -->
        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mt-10">
            <span class="font-mono text-xs text-text-muted mr-2">Filed under</span>
            {tags.map((tag) => (
              <span class="tag">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Elegant divider -->
      <div class="flex items-center gap-4 mb-14">
        <div class="flex-1 h-[1px] bg-border"></div>
        <div class="w-2 h-2 bg-accent-muted rotate-45"></div>
        <div class="flex-1 h-[1px] bg-border"></div>
      </div>

      <!-- Post content with enhanced typography -->
      <div class="post-content">
        <slot />
      </div>

      <!-- End mark -->
      <div class="mt-16 flex justify-center">
        <div class="flex items-center gap-3">
          <div class="w-8 h-[1px] bg-accent-muted"></div>
          <span class="font-display text-2xl text-accent-muted">∎</span>
          <div class="w-8 h-[1px] bg-accent-muted"></div>
        </div>
      </div>

      <!-- Author and back link -->
      <footer class="mt-16 pt-10 border-t border-border">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <!-- Author info -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-bg-card border border-border flex items-center justify-center">
              <span class="font-display text-lg text-accent">L</span>
            </div>
            <div>
              <p class="font-display text-text-primary">{author}</p>
              <p class="font-mono text-xs text-text-muted">@ludlev2</p>
            </div>
          </div>

          <!-- Back link -->
          <a href="/blog" class="btn group">
            <svg class="w-3 h-3 mr-2 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            All Articles
          </a>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
  <Terminal client:load />
</BaseLayout>

<style is:global>
  .post-content {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.9;
    color: var(--text-secondary);
    font-optical-sizing: auto;
  }

  .post-content > * + * {
    margin-top: 1.75rem;
  }

  /* Headings with editorial elegance */
  .post-content h2 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
    position: relative;
  }

  .post-content h2::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 60%;
    background: linear-gradient(to bottom, var(--accent), var(--accent-muted));
    opacity: 0.6;
  }

  .post-content h3 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .post-content h4 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs */
  .post-content p {
    color: var(--text-secondary);
    text-align: left;
    hyphens: auto;
  }

  /* First paragraph with drop cap effect */
  .post-content > p:first-of-type {
    font-size: 1.3125rem;
    line-height: 1.75;
    color: var(--text-primary);
  }

  .post-content > p:first-of-type::first-letter {
    float: left;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 4rem;
    font-weight: 500;
    line-height: 0.8;
    padding-right: 0.75rem;
    padding-top: 0.25rem;
    color: var(--accent);
  }

  /* Emphasis */
  .post-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-content em {
    font-style: italic;
    color: var(--text-primary);
  }

  /* Links with elegant underline */
  .post-content a {
    color: var(--text-primary);
    text-decoration: none;
    background-image: linear-gradient(var(--accent-muted), var(--accent-muted));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: all 0.2s ease;
  }

  .post-content a:hover {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 2px;
  }

  /* Lists with refined markers */
  .post-content ul,
  .post-content ol {
    padding-left: 1.75rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .post-content ul {
    list-style: none;
  }

  .post-content ul li {
    position: relative;
    padding-left: 0.5rem;
    margin-top: 0.75rem;
  }

  .post-content ul li::before {
    content: '—';
    position: absolute;
    left: -1.25rem;
    color: var(--accent-muted);
    font-weight: 300;
  }

  .post-content ol {
    list-style: none;
    counter-reset: list-counter;
  }

  .post-content ol li {
    position: relative;
    padding-left: 0.5rem;
    margin-top: 0.75rem;
    counter-increment: list-counter;
  }

  .post-content ol li::before {
    content: counter(list-counter) '.';
    position: absolute;
    left: -1.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: var(--accent-muted);
    font-weight: 500;
  }

  /* Blockquotes as pull quotes */
  .post-content blockquote {
    position: relative;
    margin: 3rem 0;
    padding: 2rem 2.5rem;
    border: none;
    background-color: var(--bg-card);
    border-left: 3px solid var(--accent-muted);
  }

  .post-content blockquote::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 4rem;
    color: var(--accent-muted);
    opacity: 0.5;
    line-height: 1;
  }

  .post-content blockquote p {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0;
  }

  /* Code blocks with refined styling */
  .post-content pre {
    position: relative;
    background-color: var(--bg-terminal);
    border: 1px solid var(--border);
    padding: 1.5rem;
    overflow-x: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    margin: 2.5rem 0;
  }

  .post-content pre::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-muted), transparent);
  }

  .post-content code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875em;
  }

  .post-content :not(pre) > code {
    background-color: var(--shadow-subtle);
    padding: 0.2em 0.5em;
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.85em;
  }

  /* Horizontal rules as elegant dividers */
  .post-content hr {
    border: none;
    height: auto;
    margin: 4rem auto;
    text-align: center;
    background: none;
  }

  .post-content hr::before {
    content: '⁂';
    font-size: 1.25rem;
    color: var(--accent-muted);
    letter-spacing: 0.5em;
  }

  /* Images with elegant framing */
  .post-content img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    margin: 2.5rem 0;
    box-shadow: 4px 4px 0 0 var(--shadow-subtle);
  }

  .post-content figure {
    margin: 3rem 0;
  }

  .post-content figcaption {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 1rem;
    text-align: center;
    font-style: italic;
  }

  /* Tables with refined styling */
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.9375rem;
  }

  .post-content th,
  .post-content td {
    border: 1px solid var(--border);
    padding: 0.875rem 1.25rem;
    text-align: left;
  }

  .post-content th {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background-color: var(--bg-secondary);
  }

  .post-content tr:nth-child(even) {
    background-color: var(--bg-card);
  }
</style>

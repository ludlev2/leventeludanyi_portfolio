---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site-config';
import Terminal from '@/components/Terminal/Terminal';
---

<BaseLayout>
  <main class="min-h-screen flex flex-col justify-center px-6 py-24">
    <div class="max-w-xl mx-auto w-full">
      <!-- Name - Large serif display -->
      <h1 class="heading-display text-5xl sm:text-6xl md:text-7xl mb-6 fade-in-up">
        Levente Ludanyi<span class="cursor"></span>
      </h1>

      <!-- Role - Mono uppercase -->
      <p class="heading-section mb-10 fade-in-up delay-100">
        Engineer & Founder
      </p>

      <!-- Bio -->
      <p class="text-lg text-text-secondary leading-relaxed mb-12 fade-in-up delay-200 max-w-md">
        Co-Founder at <a href="https://viewmargin.com" target="_blank" rel="noopener noreferrer" class="link-underline">Margin</a>.
        Previously Mathematics & Computer Science at École Polytechnique.
      </p>

      <!-- Divider -->
      <div class="divider-accent mb-10 fade-in-up delay-300"></div>

      <!-- Navigation - Pi-style buttons -->
      <nav class="flex flex-wrap gap-3 mb-16 fade-in-up delay-300">
        <a href="/blog" class="btn">
          Blog
        </a>
        <a href="/projects" class="btn">
          Projects
        </a>
        <a href="/about" class="btn">
          About
        </a>
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="btn">
          GitHub
          <svg class="w-3 h-3 ml-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>

      <!-- Social links - minimal -->
      <div class="flex items-center gap-6 fade-in-up delay-400">
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text-primary transition-colors"
          aria-label="Twitter"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text-primary transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-text-muted hover:text-text-primary transition-colors"
          aria-label="Email"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <!-- Spacer -->
        <div class="flex-1"></div>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="text-text-muted hover:text-text-primary transition-colors p-1"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Terminal Toggle -->
        <button
          id="terminal-toggle"
          class="text-text-muted hover:text-text-primary transition-colors p-1"
          aria-label="Open terminal"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </button>
      </div>
    </div>
  </main>

  <!-- Terminal Component (React Island) -->
  <Terminal client:load />
</BaseLayout>

<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('light', isDark);
    document.documentElement.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  });

  // Terminal toggle
  const terminalToggle = document.getElementById('terminal-toggle');
  terminalToggle?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });
</script>

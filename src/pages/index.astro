---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site-config';
import Terminal from '@/components/Terminal/Terminal';
---

<BaseLayout>
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="max-w-2xl w-full">
      <!-- Name with cursor -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-mono font-medium mb-4 fade-in-up">
        <span class="text-text-primary">Levente Ludanyi</span><span class="cursor"></span>
      </h1>

      <!-- Tagline -->
      <p class="text-lg sm:text-xl text-text-secondary font-mono mb-12 fade-in-up delay-100">
        builds things<span class="text-accent">.</span>
      </p>

      <!-- One-liner description -->
      <p class="text-text-secondary font-serif text-lg leading-relaxed mb-12 fade-in-up delay-200">
        Engineer & founder. Co-Founder at <a href="https://viewmargin.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Margin</a>.
        Previously Mathematics & Computer Science @ École Polytechnique.
      </p>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap gap-6 fade-in-up delay-300">
        <a href="/blog" class="group font-mono text-text-primary hover:text-accent transition-colors">
          <span class="text-accent">→</span> blog
        </a>
        <a href="/projects" class="group font-mono text-text-primary hover:text-accent transition-colors">
          <span class="text-accent">→</span> projects
        </a>
        <a href="/about" class="group font-mono text-text-primary hover:text-accent transition-colors">
          <span class="text-accent">→</span> about
        </a>
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="group font-mono text-text-primary hover:text-accent transition-colors">
          <span class="text-accent">→</span> github
        </a>
      </nav>

      <!-- Social links row -->
      <div class="flex items-center gap-4 mt-12 fade-in-up delay-400">
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-accent transition-colors"
          aria-label="Twitter"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-accent transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-text-muted hover:text-accent transition-colors"
          aria-label="Email"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>
  </main>

  <!-- Terminal Component (React Island) -->
  <Terminal client:load />
</BaseLayout>

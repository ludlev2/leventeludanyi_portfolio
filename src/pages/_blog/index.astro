---
import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/lib/utils';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group posts by year for editorial feel
const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<PageLayout title="Blog | Levente Ludanyi" description="Thoughts on engineering, startups, and building things.">
  <!-- Editorial header with decorative elements -->
  <header class="mb-20 relative">
    <div class="absolute -left-4 top-0 w-[2px] h-16 bg-gradient-to-b from-accent to-transparent opacity-60"></div>

    <p class="heading-section mb-6">Journal</p>

    <h1 class="heading-display text-5xl sm:text-6xl lg:text-7xl mb-8">
      Writing<span class="text-accent">.</span>
    </h1>

    <p class="text-xl text-text-secondary max-w-lg leading-relaxed">
      Thoughts on engineering, building products, and the occasional dive into whatever catches my curiosity.
    </p>

    <!-- Decorative flourish -->
    <div class="mt-12 flex items-center gap-4">
      <div class="h-[1px] w-12 bg-accent-muted"></div>
      <span class="font-mono text-xs text-text-muted tracking-wider">{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
    </div>
  </header>

  <!-- Posts grouped by year -->
  <div class="space-y-16">
    {years.map((year, yearIndex) => (
      <section>
        <!-- Year marker -->
        <div class="flex items-center gap-6 mb-8">
          <span class="font-display text-6xl sm:text-7xl font-light text-text-muted/30 select-none leading-none">
            {year}
          </span>
          <div class="flex-1 h-[1px] bg-border"></div>
        </div>

        <!-- Posts for this year -->
        <div class="space-y-1">
          {postsByYear[Number(year)].map((post, postIndex) => (
            <article class="group">
              <a
                href={`/blog/${post.slug}`}
                class="block py-6 px-5 -mx-5 border-l-2 border-transparent hover:border-accent hover:bg-bg-card/50 transition-all duration-200"
              >
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  <!-- Date column -->
                  <time
                    datetime={post.data.date.toISOString()}
                    class="font-mono text-xs text-text-muted shrink-0 tabular-nums pt-1 sm:w-24"
                  >
                    {formatDate(post.data.date)}
                  </time>

                  <!-- Content column -->
                  <div class="flex-1 min-w-0">
                    <h2 class="font-display text-xl sm:text-2xl text-text-primary group-hover:text-accent transition-colors leading-tight mb-3">
                      {post.data.title}
                    </h2>

                    {post.data.summary && (
                      <p class="text-text-secondary leading-relaxed mb-4 line-clamp-2">
                        {post.data.summary}
                      </p>
                    )}

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="tag">
                            {tag}
                          </span>
                        ))}
                        <span class="ml-auto font-mono text-xs text-text-muted group-hover:text-accent transition-colors flex items-center gap-1">
                          Read
                          <svg class="w-3 h-3 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                          </svg>
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  {posts.length === 0 && (
    <div class="text-center py-20">
      <p class="font-display text-2xl text-text-muted mb-4">Nothing here yet.</p>
      <p class="font-mono text-sm text-text-muted">Check back soon.</p>
    </div>
  )}
</PageLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

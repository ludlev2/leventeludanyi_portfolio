---
import PageLayout from '@/layouts/PageLayout.astro';

const projects = [
  {
    title: "Margin",
    description: "Co-Founder. Helping creators and businesses understand their margins and make better decisions.",
    href: "https://viewmargin.com",
    tags: ["startup", "fintech"],
  },
  {
    title: "PointSwitch",
    description: "Peer2Peer marketplace for discounts and loyalty points. We help customers save money on shopping and brands retain customers by making discounts valuable and worthwhile.",
    href: "https://pointswitch.xyz",
    tags: ["web3", "startup"],
  },
  {
    title: "Liquidity Pools Simulator",
    description: "Led a team of 20 to build a multi-agent probabilistic market simulator and liquidity pools to test different automated market makers.",
    href: "https://github.com/Liquidity-protocol-CSE201-Project/Project",
    tags: ["AMM", "cpp", "defi"],
  },
];
---

<PageLayout title="Projects | Levente Ludanyi" description="Things I've built and worked on.">
  <header class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-mono font-medium text-text-primary mb-4">
      Projects<span class="text-accent">.</span>
    </h1>
    <p class="text-text-secondary font-serif text-lg">
      Things I've built and worked on.
    </p>
  </header>

  <div class="space-y-8">
    {projects.map((project) => (
      <article class="group p-6 bg-bg-secondary/50 rounded-lg border border-bg-elevated hover:border-accent/30 transition-colors">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-xl font-mono text-text-primary group-hover:text-accent transition-colors">
            {project.title}
          </h2>
          {project.href && (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-accent transition-colors shrink-0"
              aria-label={`Visit ${project.title}`}
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>

        <p class="text-text-secondary font-serif leading-relaxed mb-4">
          {project.description}
        </p>

        {project.tags && project.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="px-2 py-0.5 text-xs font-mono bg-bg-primary text-text-muted rounded">
                {tag}
              </span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</PageLayout>

---
import PageLayout from '@/layouts/PageLayout.astro';

const projects = [
  {
    title: "Margin",
    description: "Co-Founder. Helping creators and businesses understand their margins and make better decisions.",
    href: "https://viewmargin.com",
    tags: ["startup", "fintech"],
    status: "Active",
  },
  {
    title: "PointSwitch",
    description: "Peer2Peer marketplace for discounts and loyalty points. We help customers save money on shopping and brands retain customers by making discounts valuable and worthwhile.",
    href: "https://pointswitch.xyz",
    tags: ["web3", "startup"],
    status: "Active",
  },
  {
    title: "Liquidity Pools Simulator",
    description: "Led a team of 20 to build a multi-agent probabilistic market simulator and liquidity pools to test different automated market makers.",
    href: "https://github.com/Liquidity-protocol-CSE201-Project/Project",
    tags: ["AMM", "cpp", "defi"],
    status: "Completed",
  },
];
---

<PageLayout title="Projects | Levente Ludanyi" description="Things I've built and worked on.">
  <header class="mb-16">
    <p class="heading-section mb-4">Work</p>
    <h1 class="heading-display text-4xl sm:text-5xl mb-6">
      Projects
    </h1>
    <p class="text-lg text-text-secondary max-w-md">
      Things I've built and worked on.
    </p>
  </header>

  <div class="divider mb-12"></div>

  <div class="space-y-6">
    {projects.map((project) => (
      <article class="group">
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="block card p-6"
        >
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex items-center gap-3">
              <h2 class="font-display text-xl text-text-primary group-hover:text-accent transition-colors">
                {project.title}
              </h2>
              {project.status && (
                <span class="text-xs font-mono text-text-muted border border-border px-2 py-0.5">
                  {project.status}
                </span>
              )}
            </div>
            <svg class="w-4 h-4 text-text-muted group-hover:text-text-primary transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>

          <p class="text-text-secondary leading-relaxed mb-5">
            {project.description}
          </p>

          {project.tags && project.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="tag">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      </article>
    ))}
  </div>
</PageLayout>
